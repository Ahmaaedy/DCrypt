# ---- Telegram (https://my.telegram.org -> API development tools). Use a DEDICATED account.
TG_API_ID=0
TG_API_HASH=
TG_SESSION=dcrypt
# comma-separated @usernames or numeric ids. Run `python -m dcrypt_paste dialogs` to list ids.
TG_CHANNELS=

# ---- Storage
DB_URL=sqlite+aiosqlite:///dcrypt.db

# ---- LLM normalizer: ollama | heuristic (heuristic = no LLM, regex/keywords only)
LLM_BACKEND=ollama
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# ---- Mode. Stay on paper until channel stats justify anything else.
MODE=paper

# ---- Optional on-chain safety checks (mint/freeze authority) in ANY mode
RPC_URL=

# ---- Live only (ignored in paper)
LIVE_CONFIRM=
WALLET_SECRET_KEY=
JUPITER_BASE_URL=https://lite-api.jup.ag/swap/v1
JUPITER_API_KEY=

# ---- Optional Telegram bot notifications
NOTIFY_BOT_TOKEN=
NOTIFY_CHAT_ID=

# Everything else (risk, exits, filters) has defaults in dcrypt_paste/config.py
